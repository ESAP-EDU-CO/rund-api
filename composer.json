{
	"name": "rund/api",
	"description": "RUND API - Document processing API with PHPOffice",
	"type": "project",
	"require": {
		"php": "^8.3",
		"phpoffice/phpspreadsheet": "^4.4",
		"phpoffice/phpword": "^1.4",
		"dompdf/dompdf": "^3.1",
		"endroid/qr-code": "^6.0.9",
		"ext-gd": "*",
		"ext-zip": "*",
		"ext-intl": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.0"
	},
	"autoload": {
		"psr-4": {
			"Rund\\Api\\": "app/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"composer/package-versions-deprecated": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}