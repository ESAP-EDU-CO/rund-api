{
	"name": "rund/api",
	"description": "RUND-API - Document processing API with PHPOffice",
	"type": "project",
	"require": {
		"php": "^8.3",
		"phpoffice/phpspreadsheet": "^5.2",
		"phpoffice/phpword": "^1.4",
		"dompdf/dompdf": "^3.1",
		"endroid/qr-code": "^6.0.9",
		"ext-gd": "*",
		"ext-zip": "*",
		"ext-intl": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.0"
	},
	"autoload": {
		"psr-4": {
			"RUND\\": "app/src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"RUND\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"composer/package-versions-deprecated": true
		},
		"audit": {
			"abandoned": "report"
		}
	},
	"scripts": {
		"post-autoload-dump": [
			"@php -r \"file_exists('app/src/Config/Constants.php') || exit(0); echo 'RUND autoloader configured successfully\\n';\""
		]
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}